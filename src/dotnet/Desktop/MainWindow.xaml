<Window x:Class="Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Desktop.Views" 
        xmlns:viewmodels="clr-namespace:Desktop.ViewModels" 
        xmlns:models="clr-namespace:RaktarAppShared.Models;assembly=RaktarAppShared"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="RaktárApp" Height="600" Width="1000" Background="#1e1e1e">
    <Window.Resources>
        <!-- This template will be used whenever CurrentView holds a Warehouse object -->
        <DataTemplate DataType="{x:Type models:Warehouse}">
            <views:WarehouseView/>
        </DataTemplate>
        <!-- This template will be used whenever CurrentView holds an AddWarehouseViewModel object -->
        <DataTemplate DataType="{x:Type viewmodels:AddWarehouseViewModel}">
            <views:AddWarehouseView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:EditWarehouseViewModel}">
            <views:EditWarehouseView/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Warehouses" FontSize="16" FontWeight="Bold" Margin="4" Foreground="White" Background="#121212"/>
        <Button Grid.Row="1" Content=" + New warehouse" Background="#121212" Foreground="White" Command="{Binding ShowAddWarehouseViewCommand}"></Button>
        <!-- Left vertical menu -->
        <Grid Background="#121212" Grid.Row="2">
            <ListBox ItemsSource="{Binding Warehouses}" 
                         SelectedItem="{Binding SelectedWarehouse, Mode=TwoWay}"
                         HorizontalContentAlignment="Stretch"
                         BorderThickness="0"
                         Background="#1e1e1e">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Background="#1e1e1e">
                            <TextBlock  Text="{Binding Name}" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock FontSize="12" Foreground="Gray">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="Country"/>
                                        <Binding Path="Region"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="Gray">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="City"/>
                                        <Binding Path="Address"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Right content: loads view based on the type of object in CurrentView -->
        <Border Grid.Column="1" Grid.RowSpan="3" Padding="12">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>

    </Grid>
</Window>